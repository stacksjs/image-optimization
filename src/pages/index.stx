<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>ImageOptimization</title>
  <style>
    :root { color-scheme: light dark; font: 13px/1.5 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #202633; background: #f6f7fa; --panel: #fff; --line: #e6e8ee; --muted: #7b8293; --accent: #5268e8; }
    * { box-sizing: border-box; }
    body { margin: 0; height: 100vh; display: flex; flex-direction: column; -webkit-font-smoothing: antialiased; }
    header { padding: 23px 28px 20px; display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--line); background: var(--panel); }
    .app-icon { width: 40px; height: 40px; border-radius: 12px; background: linear-gradient(145deg, #7287ff, #495cd4); color: white; display: grid; place-items: center; box-shadow: 0 3px 8px #5268e833; }
    h1 { font-size: 17px; letter-spacing: -.5px; margin: 0; font-weight: 650; }
    p { margin: 0; }
    .muted { color: var(--muted); font-size: 12px; }
    button { font: inherit; cursor: pointer; border: 1px solid var(--line); color: inherit; background: var(--panel); border-radius: 7px; padding: 7px 12px; }
    button:hover { border-color: var(--accent); }
    button:disabled { opacity: .45; cursor: default; }
    button:focus-visible, .drop:focus-visible { outline: 3px solid #5268e866; outline-offset: 3px; }
    .primary { background: var(--accent); border-color: var(--accent); color: white; }
    .add { margin-left: auto; }
    main { flex: 1; min-height: 0; overflow: auto; padding: 24px 28px; }
    .drop { width: 100%; min-height: 224px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9px; border: 1.5px dashed #c9cfe3; border-radius: 12px; background: var(--panel); color: inherit; }
    .drop-icon { color: var(--accent); margin-bottom: 4px; }
    .drop strong { font-size: 16px; font-weight: 550; }
    .formats { margin-top: 20px; text-align: center; color: var(--muted); font-size: 11px; letter-spacing: .8px; }
    .table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    th { color: var(--muted); font-size: 10px; letter-spacing: .9px; text-transform: uppercase; font-weight: 500; text-align: right; padding: 0 10px 12px; }
    th:first-child { text-align: left; }
    td { border-top: 1px solid var(--line); padding: 12px 10px; text-align: right; white-space: nowrap; font-size: 12px; }
    td:first-child { text-align: left; max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
    .file-name { font-weight: 550; }
    .file-note { color: var(--muted); font-size: 10px; overflow: hidden; text-overflow: ellipsis; }
    .saving { color: #159970; font-weight: 600; }
    .failed { color: #d2475c; font-weight: 600; }
    .neutral { color: var(--muted); }
    .row-action { padding: 3px 7px; font-size: 11px; }
    .drop-mini { margin-top: 14px; padding: 12px; min-height: 0; font-size: 12px; color: var(--muted); }
    footer { border-top: 1px solid var(--line); background: var(--panel); padding: 13px 28px; display: flex; align-items: center; gap: 14px; min-height: 67px; }
    .destination { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .summary { flex: 1; }
    .summary strong { display: block; font-size: 12px; }
    .privacy { font-size: 10px; color: var(--muted); }
    .error { color: #d2475c; font-size: 12px; padding: 8px 0; }
    [hidden] { display: none !important; }
    @media(prefers-color-scheme:dark) { :root { background:#181a21; color:#e6e9f3; --panel:#20232c; --line:#313541; --muted:#9da5b8; } .drop { border-color:#414965; } }
  </style>
</head>
<body @dragover.prevent @drop.prevent="drop()">
  <header>
    <div class="app-icon" aria-hidden="true"><svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="4"/><circle cx="8" cy="8" r="1.3"/><path d="m4 17 5-5 4 4 3-3 4 4"/></svg></div>
    <div><h1>ImageOptimization</h1><p class="muted">Less weight. Same image.</p></div>
    <button class="add primary" @click="choose()">＋ Add images</button>
  </header>
  <main>
    <div :hidden="files().length > 0">
      <button class="drop" @click="choose()">
        <svg class="drop-icon" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M4 15v5h16v-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <strong>Give your images a little breathing room.</strong>
        <span class="muted">Drop images here, or click to choose files</span>
        <span class="muted">Originals preserved. Smaller copies only.</span>
      </button>
      <p class="formats">PNG · JPEG · WEBP · GIF · SVG · BMP · AVIF</p>
    </div>
    <div :hidden="files().length === 0">
      <table class="table" aria-label="Image optimization results">
        <thead><tr><th>Image</th><th>Original</th><th>Optimized</th><th>Saved</th><th></th></tr></thead>
        <tbody>
          <template :for="item in files()" :key="item.id">
            <tr :title="item.outputPath || item.note || ''">
              <td><div class="file-name">{{ item.name }}</div><div class="file-note">{{ item.status === 'pending' ? 'Optimizing…' : item.status === 'error' ? item.note : item.wrote ? 'Copy saved · original preserved' : item.note || 'Already optimized' }}</div></td>
              <td>{{ size(item.inputSize) }}</td><td>{{ item.status === 'done' ? size(item.outputSize) : '—' }}</td>
              <td :class="item.status === 'error' ? 'failed' : item.saved > 0 ? 'saving' : 'neutral'">{{ item.status === 'done' ? item.savedPct.toFixed(1) + '%' : item.status === 'error' ? 'Failed' : '…' }}</td>
              <td><button class="row-action" :disabled="item.status === 'pending'" @click="remove(item.id)" aria-label="Remove image">×</button></td>
            </tr>
          </template>
        </tbody>
      </table>
      <button class="drop drop-mini" @click="choose()">＋ Add more images, or drop them anywhere</button>
    </div>
    <p class="error" role="alert">{{ error() }}</p>
  </main>
  <footer>
    <div class="summary"><strong aria-live="polite">{{ summary() }}</strong><span class="privacy">On your Mac. No uploads. Originals preserved.</span></div>
    <button class="destination" :disabled="busy()" :title="outputDirectory() || 'Choose where optimized copies are saved'" @click="chooseOutputFolder()">{{ outputDirectory() ? outputDirectory().split('/').pop() + ' ▾' : 'Output folder…' }}</button>
    <button @click="clear()" :disabled="busy() || files().length === 0">Clear</button>
  </footer>
  <script client>
    import { app, showOpenDialog, isAvailable } from '@stacksjs/desktop/browser'

    const outputDirectory = state('')
    const files = state([])
    const error = state('')
    const busy = derived(() => files().some(item => item.status === 'pending'))
    const summary = derived(() => {
      const items = files()
      if (!items.length) return 'Small files. Full quality.'
      const saved = items.reduce((total, item) => total + (item.saved || 0), 0)
      const failed = items.filter(item => item.status === 'error').length
      return `${items.length} image${items.length === 1 ? '' : 's'} · ${size(saved)} saved${busy() ? ' · working…' : ''}${failed ? ` · ${failed} failed` : ''}`
    })
    let queue = Promise.resolve()
    let folderChoice = null

    function requireNativeFiles() {
      if (!isAvailable('dialog'))
        throw new Error('Native file access is unavailable. Open the macOS app and try again.')
    }

    function size(value) {
      if (!value) return '0 B'
      if (value < 1024) return `${value} B`
      if (value < 1048576) return `${(value / 1024).toFixed(1)} KB`
      return `${(value / 1048576).toFixed(2)} MB`
    }
    function update(id, patch) {
      files.set(files().map(item => item.id === id ? { ...item, ...patch } : item))
    }
    function enqueue(entries) {
      error.set('')
      for (const entry of entries) {
        if (entry.path && files().some(item => item.path === entry.path)) continue
        const item = { id: crypto.randomUUID(), inputSize: 0, outputSize: 0, saved: 0, savedPct: 0, status: 'pending', ...entry, outputDirectory: outputDirectory() }
        files.set([...files(), item])
        queue = queue.then(() => run(item)).catch(err => error.set(err.message))
      }
    }
    async function run(item) {
      try {
        const query = `path=${encodeURIComponent(item.path)}${item.outputDirectory ? `&outputDirectory=${encodeURIComponent(item.outputDirectory)}` : ''}`
        const response = await fetch(`/optimize?${query}`, {
          method: 'POST',
          headers: { 'content-type': 'application/octet-stream' },
        })
        if (!response.ok) throw new Error(await response.text())
        const meta = JSON.parse(decodeURIComponent(response.headers.get('x-stx-result') || '%7B%7D'))
        update(item.id, { ...meta, status: 'done' })
      }
      catch (err) {
        update(item.id, { status: 'error', note: err.message })
        error.set(`${item.name}: ${err.message}`)
      }
    }
    async function choose() {
      try {
        requireNativeFiles()
        const chosen = await showOpenDialog({ title: 'Choose images to optimize', multiSelections: true, filters: [{ name: 'Images', extensions: ['png','jpg','jpeg','webp','gif','svg','bmp','avif'] }] })
        if (!chosen.canceled) await paths(chosen.filePaths)
      }
      catch (err) { error.set(`Could not open images: ${err.message}`) }
    }
    async function chooseOutputFolder() {
      if (folderChoice) return await folderChoice
      folderChoice = (async () => {
        requireNativeFiles()
        const chosen = await showOpenDialog({ title: 'Choose a folder for optimized copies', canChooseDirectories: true, canChooseFiles: false, canCreateDirectories: true, buttonLabel: 'Save copies here' })
        if (chosen.canceled || !chosen.filePaths.length) return false
        error.set('')
        outputDirectory.set(chosen.filePaths[0])
        return true
      })()
      try { return await folderChoice }
      catch (err) { error.set(`Could not choose an output folder: ${err.message}`); return false }
      finally { folderChoice = null }
    }
    async function paths(values) {
      try {
        if (!values.length) return
        requireNativeFiles()
        const info = await app.getInfo()
        if (!info.bundleId || typeof info.sandboxed !== 'boolean')
          throw new Error('Native app metadata is unavailable. Reopen the macOS app and try again.')
        if (info.sandboxed && !outputDirectory() && !await chooseOutputFolder()) return
        enqueue(values.map(path => ({ path, name: path.split('/').pop() })))
      }
      catch (err) { error.set(`Could not open images: ${err.message}`) }
    }
    function drop() {
      // Craft consumes native drops itself and emits paths once. Ignoring the
      // WebView event prevents duplicate work regardless of event ordering.
      try { requireNativeFiles() }
      catch (err) { error.set(err.message) }
    }
    function remove(id) { files.set(files().filter(item => item.id !== id)) }
    function clear() { files.set([]); error.set('') }
    useEventListener('craft:fileDrop', event => paths(event.detail?.paths || []))
  </script>
</body>
</html>
